<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Quintfall</title>
        <title type="subordinate">Prélude pour la Nuict, T. 26–30, Bass</title>
        <composer>Jean-Baptiste Lully</composer>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Basse continue nach Niels Pfeffers Reduktion des Prélude (Mai 2022), die auf Muffat S. 77 verweist. Taktzahlen vom Beginn des Prélude gezählt. Das A in T. 30 ist bei Lully eine Viertel.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>Jean-Baptiste Lully, Le Triomphe de l'Amour, Paris: Ballard 1681, S. 86 ff.</bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
