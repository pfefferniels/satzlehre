<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Sonata seconda, Grave</title>
        <composer>Georg Muffat</composer>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Schlüssel modernisiert: Viola 1 steht in der Vorlage im Altschlüssel, Viola 2 im Tenorschlüssel, hier im oktavierenden Violinschlüssel. T und S bezeichnen wie in der Vorlage Tutti und Solo, + ist das Verzierungszeichen der Vorlage. Die Übertragung steht wie die Vorlage unter CC BY-SA 3.0.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>Georg Muffat, Armonico tributo, Salzburg 1682, Sonata II, Grave. Vorlage: Edition von Kompy, IMSLP #127800, rev. 1.1, CC BY-SA 3.0.</bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
