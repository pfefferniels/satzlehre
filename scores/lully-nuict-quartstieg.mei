  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Quartstieg</title>
        <title type="subordinate">Prélude pour la Nuict, T. 40–42, Bass</title>
        <composer>Jean-Baptiste Lully</composer>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Basse continue nach Niels Pfeffers Reduktion des Prélude (Mai 2022), die auf Muffat S. 70 verweist. Taktzahlen vom Beginn des Prélude gezählt.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>Jean-Baptiste Lully, Le Triomphe de l'Amour, Paris: Ballard 1681, S. 86 ff.</bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
