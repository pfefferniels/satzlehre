<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Terzfall</title>
        <title type="subordinate">Modell nach dem Bass im Prélude pour la Nuict</title>
        <composer>Jean-Baptiste Lully</composer>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Der Bass aus Niels Pfeffers Reduktion des Prélude (Mai 2022) ohne Diminutionen und Tonwiederholungen, in gleichen Werten. Vgl. Georg Muffat, Regulae concentuum partiturae (1699), S. 67 der in der Reduktion benutzten Ausgabe.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>Jean-Baptiste Lully, Le Triomphe de l'Amour, Paris: Ballard 1681, S. 86 ff.</bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
