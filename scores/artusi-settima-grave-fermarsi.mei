<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Settima, l'Agente nel Grave: fermarsi</title>
        <composer>Giovanni Maria Artusi</composer>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Artusi notiert die Synkope der Patiente als Semibrevis ohne Haltebogen, hier auf zwei Halbe mit Bogen verteilt. Die Ausgabe von 1598 verlängert das Beispiel um einen Takt.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>Giovanni Maria Artusi, Seconda parte dell'arte del contraponto, Venedig: Giacomo Vincenti 1589, S. 38 (Transkription nach Thesaurus Musicarum Italicarum, Utrecht); vgl. L'arte del contraponto, Venedig 1598, S. 47.</bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
  <music>
    <body>
