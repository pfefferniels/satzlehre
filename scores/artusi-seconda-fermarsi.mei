<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Seconda, parte agente nell'acuto: fermarsi</title>
        <composer>Giovanni Maria Artusi</composer>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Beide Stimmen im Original mit c1-Schlüssel. Artusi notiert die Synkope der Patiente als Semibrevis ohne Haltebogen, hier auf zwei Halbe mit Bogen verteilt.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>Giovanni Maria Artusi, Seconda parte dell'arte del contraponto, Venedig: Giacomo Vincenti 1589, S. 30 (Transkription nach Thesaurus Musicarum Italicarum, Utrecht); vgl. L'arte del contraponto, Venedig 1598, S. 41.</bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
