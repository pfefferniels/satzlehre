<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Quintstieg</title>
        <title type="subordinate">Prélude pour la Nuict, T. 22–24, tiefste Stimme</title>
        <composer>Jean-Baptiste Lully</composer>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Nach Niels Pfeffers Reduktion des Prélude (Mai 2022), die auf Muffat S. 73 verweist. Taktzahlen vom Beginn des Prélude gezählt. Der Basse continue und die Bratschen pausieren in T. 22–25, die tiefste Stimme ist die dritte Violinstimme. Sie steht hier wie in der Reduktion eine Oktave tiefer.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>Jean-Baptiste Lully, Le Triomphe de l'Amour, Paris: Ballard 1681, S. 86 ff.</bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
  <music>
    <body>
      <mdiv>
        <score>
